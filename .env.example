# Docker Compose PostgreSQL
# Bu dosyada gerçek parola saklamayın. Kopyalayıp .env olarak kullanın:
#   copy .env.example .env
POSTGRES_DB=your_database_here
POSTGRES_USER=your_user_here
POSTGRES_PASSWORD=your_password_here

# Yerel (Docker dışı) API
# Parola kısmını POSTGRES_PASSWORD ile aynı yer tutucudan değiştirin.
DATABASE_URL=postgresql+psycopg://your_user_here:your_password_here@127.0.0.1:5432/your_database_here
MODEL_PATH=artifacts/model.pkl
METRICS_PATH=artifacts/metrics.json

# Dinleyici ve panel
IDS_API_URL=http://127.0.0.1:8000
SNIFFER_INTERFACE=
SNIFFER_OUTPUT=http
# IDS_DEMO=1
